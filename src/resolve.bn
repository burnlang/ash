import "fs"
import "git.bn"
import "manifest.bn"
import "paths.bn"
import "semver.bn"
import "ui.bn"

pub def type Want {
    string name
    string spec
    string url
    string path
    string from
}

pub def type Resolution {
    [LockEntry] entries
    int downloaded
    {string: string} added
}

priv def type Pending {
    [Want] items
}

pub fun cacheDir(name: string, rev: string): string {
    return burnHome() + "/packages/" + name + "@" + substring(rev, 0, 12)
}

pub fun packageDir(root: string, e: LockEntry): string {
    if (startsWith(e.source, "path+")) {
        return normPath(root + "/" + substring(e.source, 5))
    }
    return cacheDir(e.name, e.rev)
}

priv fun sourceUrl(e: LockEntry): string {
    if (startsWith(e.source, "git+")) {
        return substring(e.source, 4)
    }
    return ""
}

pub fun allows(spec: string, e: LockEntry): bool {
    var s = parseSpec(spec)
    if (s.kind == "any") {
        return true
    }
    if (s.kind == "rev") {
        return startsWith(e.rev, s.text)
    }
    if (s.kind == "branch") {
        return e.version == s.text
    }
    return specAllows(s, parseVersion(e.version))
}

priv fun describe(wants: [Want]): string {
    var parts: [string] = []
    for (w in wants) {
        parts.push("${w.from} needs ${w.spec}")
    }
    return join(parts, ", ")
}

pub fun chooseVersion(name: string, wants: [Want], url: string): LockEntry {
    var remote = lsRemote(url)
    if (remote.error != "") {
        die("cannot reach ${name} (${url}): ${remote.error}", "check the name, or set `git = \"...\"` for this dependency in burn.toml")
    }
    var source = "git+" + url
    for (w in wants) {
        var s = parseSpec(w.spec)
        if (s.kind == "rev") {
            return LockEntry { name: name, version: substring(s.text, 0, 12), rev: s.text, source: source, deps: [] }
        }
        if (s.kind == "branch") {
            var sha = remote.heads[s.text] ?? remote.tags[s.text]
            if (sha == null) {
                die("${name} has no branch or tag `${s.text}`", "${w.from} asks for it in burn.toml")
            }
            return LockEntry { name: name, version: s.text, rev: sha!!, source: source, deps: [] }
        }
    }
    var best = ""
    var bestV = parseVersion("0")
    var tagged: [string] = []
    for tag, sha in remote.tags {
        var v = parseVersion(tag)
        if (!v.ok) {
            continue
        }
        tagged.push(tag)
        var fits = true
        for (w in wants) {
            if (!specAllows(parseSpec(w.spec), v)) {
                fits = false
            }
        }
        if (fits && (best == "" || compareVersions(v, bestV) > 0)) {
            best = tag
            bestV = v
        }
    }
    if (best != "") {
        return LockEntry { name: name, version: best, rev: remote.tags[best]!!, source: source, deps: [] }
    }
    var onlyAny = true
    for (w in wants) {
        if (parseSpec(w.spec).kind != "any") {
            onlyAny = false
        }
    }
    if (len(tagged) == 0 && onlyAny && remote.head != "") {
        var branch = remote.headBranch
        if (branch == "") {
            branch = "HEAD"
        }
        return LockEntry { name: name, version: branch, rev: remote.head, source: source, deps: [] }
    }
    sort(tagged)
    var available = "it has no version tags"
    if (len(tagged) > 0) {
        available = "available: " + join(tagged, ", ")
    }
    die("no version of ${name} matches (${describe(wants)})", available)
    return LockEntry { name: name, version: "", rev: "", source: source, deps: [] }
}

pub fun ensure(root: string, e: LockEntry, res: Resolution): string {
    var dir = packageDir(root, e)
    if (Files.isFile(dir + "/burn.toml")) {
        return dir
    }
    if (startsWith(e.source, "path+")) {
        die("${e.name} should be in ${dir}, but there is no burn.toml there", "")
    }
    var ref = e.version
    if (startsWith(e.rev, ref)) {
        ref = ""
    }
    step("Downloading", "${e.name} ${e.version}")
    var err = download(sourceUrl(e), ref, e.rev, dir)
    if (err != "") {
        die("cannot download ${e.name}: ${err}", "")
    }
    if (!Files.isFile(dir + "/burn.toml")) {
        Files.remove(dir)
        die("${e.name} is not a Burn package: it has no burn.toml", "only git repositories with a burn.toml at the top can be installed")
    }
    res.downloaded += 1
    return dir
}

priv fun wantsOf(dep: Dep, fromDir: string, root: string, from: string): Want {
    var path = ""
    if (dep.path != "") {
        var full = dep.path
        if (!startsWith(full, "/")) {
            full = fromDir + "/" + full
        }
        path = relPath(root, normPath(full))
    }
    return Want { name: dep.name, spec: dep.spec, url: gitUrl(dep), path: path, from: from }
}

pub fun resolve(m: Manifest, lock: [LockEntry], refresh: [string], refreshAll: bool): Resolution {
    var res = Resolution { entries: [], downloaded: 0, added: {} }
    var chosen: {string: LockEntry} = {}
    var wants: {string: [Want]} = {}
    var queue = Pending { items: [] }
    for (d in m.deps) {
        queue.items.push(wantsOf(d, m.root, m.root, "burn.toml"))
    }
    var i = 0
    while (i < len(queue.items)) {
        var w = queue.items[i]
        i += 1
        if (w.name == m.name) {
            continue
        }
        if (wants[w.name] == null) {
            wants[w.name] = []
        }
        var list = wants[w.name]!!
        list.push(w)
        var current = chosen[w.name]
        if (current != null) {
            if (w.path != "" || startsWith(current.source, "path+") || allows(w.spec, current)) {
                continue
            }
            var again = chooseVersion(w.name, list, w.url)
            if (again.rev == current.rev) {
                continue
            }
            chosen[w.name] = again
        } else if (w.path != "") {
            chosen[w.name] = LockEntry { name: w.name, version: "", rev: "", source: "path+" + w.path, deps: [] }
        } else {
            var old = findLocked(lock, w.name)
            var reuse = old != null && !refreshAll && !contains(refresh, w.name) && sourceUrl(old!!) == w.url
            if (reuse) {
                for (x in list) {
                    if (!allows(x.spec, old!!)) {
                        reuse = false
                    }
                }
            }
            if (reuse) {
                chosen[w.name] = LockEntry { name: old!!.name, version: old!!.version, rev: old!!.rev, source: old!!.source, deps: [] }
            } else {
                chosen[w.name] = chooseVersion(w.name, list, w.url)
            }
        }
        var e = chosen[w.name]!!
        var dir = ensure(m.root, e, res)
        var sub = readManifest(dir)
        if (sub.name != w.name) {
            warn("${w.name} calls itself ${sub.name} in its burn.toml")
        }
        if (sub.kind != "lib") {
            die("${w.name} is an app, not a library", "install apps as commands with `ash install -g ${w.name}`")
        }
        if (startsWith(e.source, "path+")) {
            e.version = sub.version
        }
        e.deps = []
        for (d in sub.deps) {
            if (d.path != "" && !startsWith(e.source, "path+")) {
                die("${w.name} depends on ${d.name} by path, which only works inside one machine", "ask its author to publish ${d.name}")
            }
            e.deps.push(d.name)
            queue.items.push(wantsOf(d, dir, m.root, w.name + " " + e.version))
        }
    }
    var keep: {string: bool} = {}
    var stack: [string] = []
    for (d in m.deps) {
        stack.push(d.name)
    }
    while (len(stack) > 0) {
        var n = stack.pop()
        if (keep[n] != null || chosen[n] == null) {
            continue
        }
        keep[n] = true
        for (d in chosen[n]!!.deps) {
            stack.push(d)
        }
    }
    for n, e in chosen {
        if (keep[n] != null) {
            res.entries.push(e)
            var old = findLocked(lock, n)
            if (old == null || old.rev != e.rev || old.source != e.source) {
                res.added[n] = e.version
            }
        }
    }
    return res
}

pub fun fetchLocked(root: string, lock: [LockEntry]): Resolution {
    var res = Resolution { entries: lock, downloaded: 0, added: {} }
    for (e in lock) {
        ensure(root, e, res)
    }
    return res
}

pub fun lockMatches(m: Manifest, lock: [LockEntry]): bool {
    for (d in m.deps) {
        var e = findLocked(lock, d.name)
        if (e == null) {
            return false
        }
        if (d.path != "") {
            if (e.source != "path+" + relPath(m.root, normPath(m.root + "/" + d.path))) {
                return false
            }
        } else if (sourceUrl(e!!) != gitUrl(d) || !allows(d.spec, e!!)) {
            return false
        }
    }
    return true
}
