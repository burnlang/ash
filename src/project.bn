import "fs"
import "process"
import "strings"
import "manifest.bn"
import "paths.bn"
import "resolve.bn"
import "semver.bn"
import "ui.bn"
import "std/time"
import "std/math"

pub def type Request {
    string name
    string spec
    string git
    string path
    bool explicitSpec
}

pub fun projectRoot(): string {
    var root = findProjectRoot(".")
    if (root == "") {
        die("there is no burn.toml here or in any parent directory", "create a project with `ash init github.com/you/project`")
    }
    return root
}

/** What a package command works on: the folder of the burn.lock, and the dependencies to resolve into it. */
pub def type Scope {
    string root
    Manifest manifest
    Workspace? workspace
}

/** The workspace that `dir` is the root or a member of. */
pub fun workspaceOf(dir: string): Workspace? {
    var here = normPath(absPath(dir))
    var cur = here
    while (true) {
        var w = readWorkspace(cur)
        if (w != null) {
            if (normPath(w.root) == here || contains(w.dirs, here)) {
                return w
            }
            return null
        }
        if (cur == "/" || cur == ".") {
            return null
        }
        cur = parentDir(cur)
    }
}

/** Every member's dependencies as one manifest, so the workspace gets one burn.lock. `changed` replaces the member it belongs to. */
pub fun combined(ws: Workspace, changed: Manifest?): Manifest {
    var m = Manifest {
        root: ws.root,
        name: ws.name,
        version: "",
        kind: "workspace",
        target: "",
        main: "",
        description: "",
        deps: [],
        scriptNames: [],
        scripts: {},
        members: []
    }
    [Manifest] all = []
    for (dir in ws.dirs) {
        if (!Files.isFile(dir + "/burn.toml")) {
            die("the workspace member ${relPath(ws.root, dir)} has no burn.toml", "create it with `burn init` inside the workspace, or remove it from `members`")
        }
        var mm = readManifest(dir)
        if (changed != null && normPath(changed.root) == dir) {
            mm = changed
        }
        all.push(mm)
        m.members.push(mm.name)
    }
    for (mm in all) {
        for (d in mm.deps) {
            if (contains(m.members, d.name)) {
                continue
            }
            var dep = Dep { name: d.name, spec: d.spec, git: d.git, path: d.path }
            if (d.path != "" && !startsWith(d.path, "/")) {
                dep.path = relPath(ws.root, normPath(mm.root + "/" + d.path))
            }
            m.deps.push(dep)
        }
    }
    return m
}

/** The scope of the project in the current folder; `changed` is its manifest with edits that are not saved yet. */
pub fun currentScope(changed: Manifest?): Scope {
    var root = projectRoot()
    var ws = workspaceOf(root)
    if (ws == null) {
        return Scope { root: root, manifest: changed ?? readManifest(root), workspace: null }
    }
    return Scope { root: ws.root, manifest: combined(ws, changed), workspace: ws }
}

priv fun scopeName(s: Scope): string {
    if (s.workspace != null && s.manifest.name == "") {
        return "the workspace"
    }
    return s.manifest.name
}

pub fun elapsed(start: int): string {
    var ms = nowMs() - start
    if (ms < 1000) {
        return "${ms}ms"
    }
    return "${ms / 1000}.${(ms % 1000) / 100}s"
}

pub fun parseRequest(arg: string, git: string): Request {
    if (startsWith(arg, ".") || startsWith(arg, "/") || (Files.isDir(arg) && Files.isFile(arg + "/burn.toml"))) {
        var dir = absPath(arg)
        if (!Files.isFile(dir + "/burn.toml")) {
            die("${arg} is not a Burn project: it has no burn.toml", "")
        }
        var m = readManifest(dir)
        return Request { name: m.name, spec: "*", git: "", path: dir, explicitSpec: false }
    }
    var name = arg
    var spec = "*"
    var explicit = false
    var at = indexOf(arg, "@")
    if (at >= 0) {
        name = substring(arg, 0, at)
        spec = substring(arg, at + 1)
        explicit = true
        if (spec == "") {
            die("`${arg}` has an empty version after `@`", "write `${name}@1.2` or just `${name}`")
        }
    }
    if (!validName(name)) {
        var help = nameHelp()
        if (!contains(name, "/")) {
            help = "packages are named after where they live, for example `github.com/<owner>/${name}`; search with `ash search ${name}`"
        }
        die("`${name}` is not a package name", help)
    }
    return Request { name: name, spec: spec, git: git, path: "", explicitSpec: explicit }
}

pub fun specFor(e: LockEntry): string {
    var v = parseVersion(e.version)
    if (v.ok) {
        return caretFor(v)
    }
    return e.version
}

priv fun depValue(r: Request, root: string, spec: string): string {
    if (r.path != "") {
        return "{ path = \"" + relPath(root, r.path) + "\" }"
    }
    if (r.git != "") {
        return "{ version = \"" + spec + "\", git = \"" + r.git + "\" }"
    }
    return "\"" + spec + "\""
}

priv fun report(res: Resolution, start: int, verb: string) {
    var names = keys(res.added)
    sort(names)
    for (n in names) {
        var v = res.added[n]!!
        step(verb, "${n} ${v}")
    }
    var count = len(res.entries)
    var noun = "packages"
    if (count == 1) {
        noun = "package"
    }
    step("Finished", "${count} ${noun} ready in ${elapsed(start)}")
}

pub fun installAll() {
    var start = nowMs()
    var scope = currentScope(null)
    var root = scope.root
    var m = scope.manifest
    var lock = readLock(root)
    if (len(m.deps) == 0) {
        writeLock(root, [])
        step("Finished", "${scopeName(scope)} has no dependencies")
        return
    }
    if (lockMatches(m, lock)) {
        var res = fetchLocked(root, lock)
        step("Finished", "${len(lock)} packages ready in ${elapsed(start)}")
        return
    }
    var res = resolve(m, lock, [], false)
    writeLock(root, res.entries)
    report(res, start, "Locked")
}

pub fun installPackages(requests: [Request]) {
    var start = nowMs()
    var root = projectRoot()
    var m = readManifest(root)
    var refresh: [string] = []
    for (r in requests) {
        if (r.name == m.name) {
            die("${m.name} cannot depend on itself", "")
        }
        var found = false
        for (d in m.deps) {
            if (d.name == r.name) {
                d.spec = r.spec
                d.git = r.git
                d.path = r.path
                found = true
            }
        }
        if (!found) {
            m.deps.push(Dep { name: r.name, spec: r.spec, git: r.git, path: r.path })
        }
        refresh.push(r.name)
    }
    var scope = currentScope(m)
    var res = resolve(scope.manifest, readLock(scope.root), refresh, false)
    for (r in requests) {
        var spec = r.spec
        for (e in res.entries) {
            if (e.name == r.name && !r.explicitSpec) {
                spec = specFor(e)
            }
        }
        setDependency(root, r.name, depValue(r, root, spec))
    }
    writeLock(scope.root, res.entries)
    report(res, start, "Added")
}

pub fun removePackages(names: [string]) {
    var start = nowMs()
    var root = projectRoot()
    var m = readManifest(root)
    var kept: [Dep] = []
    for (n in names) {
        var found = false
        for (d in m.deps) {
            if (d.name == n) {
                found = true
            }
        }
        if (!found) {
            var have: [string] = []
            for (d in m.deps) {
                have.push(d.name)
            }
            var help = "burn.toml has no dependencies"
            if (len(have) > 0) {
                help = "its dependencies are " + join(have, ", ")
            }
            die("${n} is not a dependency of ${m.name}", help)
        }
    }
    for (d in m.deps) {
        if (!contains(names, d.name)) {
            kept.push(d)
        }
    }
    m.deps = kept
    var scope = currentScope(m)
    var res = resolve(scope.manifest, readLock(scope.root), [], false)
    for (n in names) {
        setDependency(root, n, "")
        step("Removed", n)
    }
    writeLock(scope.root, res.entries)
    step("Finished", "in ${elapsed(start)}")
}

pub fun updatePackages(names: [string]) {
    var start = nowMs()
    var scope = currentScope(null)
    var root = scope.root
    var m = scope.manifest
    var lock = readLock(root)
    for (n in names) {
        if (findLocked(lock, n) == null) {
            die("${n} is not installed in ${scopeName(scope)}", "see what is installed with `ash list`")
        }
    }
    var res = resolve(m, lock, names, len(names) == 0)
    var changed = 0
    for (e in res.entries) {
        var old = findLocked(lock, e.name)
        if (old == null) {
            step("Added", "${e.name} ${e.version}")
            changed += 1
        } else if (old.rev != e.rev) {
            step("Updated", "${e.name} ${old.version} -> ${e.version}")
            changed += 1
        }
    }
    writeLock(root, res.entries)
    if (changed == 0) {
        step("Finished", "everything is up to date (${elapsed(start)})")
    } else {
        step("Finished", "in ${elapsed(start)}")
    }
}

priv fun tree(lock: [LockEntry], name: string, prefix: string, last: bool, seen: [string]) {
    var e = findLocked(lock, name)
    var branch = "├── "
    var next = prefix + "│   "
    if (last) {
        branch = "└── "
        next = prefix + "    "
    }
    if (e == null) {
        print(prefix + branch + name + " " + red("(not installed, run `ash install`)"))
        return
    }
    var where = ""
    if (startsWith(e.source, "path+")) {
        where = dim(" (" + substring(e.source, 5) + ")")
    }
    var repeated = contains(seen, name)
    var mark = ""
    if (repeated && len(e.deps) > 0) {
        mark = dim(" (see above)")
    }
    print(prefix + branch + bold(name) + " " + cyan(e.version) + where + mark)
    if (repeated) {
        return
    }
    seen.push(name)
    for i, d in e.deps {
        tree(lock, d, next, i == len(e.deps) - 1, seen)
    }
}

pub fun listPackages() {
    var scope = currentScope(null)
    var w = scope.workspace
    if (w != null && normPath(projectRoot()) == normPath(w.root)) {
        for (dir in w.dirs) {
            listTree(readManifest(dir), readLock(scope.root), scope.manifest.members)
        }
        return
    }
    listTree(readManifest(projectRoot()), readLock(scope.root), scope.manifest.members)
}

priv fun listTree(m: Manifest, lock: [LockEntry], members: [string]) {
    print(bold(m.name) + " " + m.version)
    if (len(m.deps) == 0) {
        print(dim("no dependencies; add one with `ash install <name>`"))
        return
    }
    var seen: [string] = []
    for i, d in m.deps {
        if (contains(members, d.name)) {
            var branch = "├── "
            if (i == len(m.deps) - 1) {
                branch = "└── "
            }
            print(branch + bold(d.name) + dim(" (workspace member)"))
            continue
        }
        tree(lock, d.name, "", i == len(m.deps) - 1, seen)
    }
}

pub fun burnExe(): string {
    var b = env("BURN")
    if (b != "") {
        return b
    }
    return "burn"
}

pub fun runBurn(args: [string]): int {
    var code = Process.run(burnExe(), args)
    if (code == -1) {
        die("the `burn` command was not found", "install the Burn toolchain with burnup, or set BURN to the burn binary")
    }
    return code
}

pub fun runScript(m: Manifest, name: string, extra: [string]): int {
    var cmd = m.scripts[name]
    if (cmd == null) {
        var help = "burn.toml has no scripts"
        if (len(m.scriptNames) > 0) {
            help = "its scripts are " + join(m.scriptNames, ", ")
        }
        die("there is no script called `${name}`", help)
    }
    var line = cmd!!
    for (a in extra) {
        line = line + " " + shellQuote(a)
    }
    print(dim("$ " + line))
    Process.setCwd(m.root)
    return Process.shell(line)
}

pub fun listScripts(m: Manifest) {
    if (len(m.scriptNames) == 0) {
        print(dim("burn.toml has no scripts; add them under [scripts], like  dev = \"burni src/main.bn\""))
        return
    }
    var width = 0
    for (n in m.scriptNames) {
        width = max(width, len(n))
    }
    for (n in m.scriptNames) {
        print("  " + green(padRight(n, width, " ")) + "  " + m.scripts[n]!!)
    }
}

priv fun collect(dir: string, suffix: string, out: [string]) {
    for (name in Files.list(dir)) {
        if (startsWith(name, ".") || name == "build") {
            continue
        }
        var p = dir + "/" + name
        if (Files.isDir(p)) {
            collect(p, suffix, out)
        } else if (endsWith(name, suffix)) {
            out.push(p)
        }
    }
}

pub fun sourceFiles(root: string): [string] {
    var out: [string] = []
    collect(root, ".bn", out)
    return out
}

pub fun runTests(m: Manifest, extra: [string]): int {
    var files: [string] = []
    for (f in Files.list(m.root + "/tests")) {
        if (endsWith(f, ".bn")) {
            files.push("tests/" + f)
        }
    }
    if (len(files) == 0) {
        warn("there are no tests: add .bn files to tests/, or a `test` script to burn.toml")
        return 0
    }
    Process.setCwd(m.root)
    var failed: [string] = []
    for (f in files) {
        var args = ["run", f]
        for (a in extra) {
            args.push(a)
        }
        print(dim("$ burn run " + f))
        if (runBurn(args) != 0) {
            failed.push(f)
        }
    }
    if (len(failed) > 0) {
        eprint(red("failed:") + " " + join(failed, ", "))
        return 1
    }
    step("Passed", "${len(files)} test files")
    return 0
}
