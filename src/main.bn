import "fs"
import "process"
import "strings"
import "git.bn"
import "index.bn"
import "manifest.bn"
import "paths.bn"
import "project.bn"
import "tools.bn"
import "ui.bn"

const VERSION = "0.1.0"

priv fun help() {
    print(bold("ash") + " " + VERSION + " - the Burn package manager")
    print("")
    print(bold("Projects"))
    print("  ash init <name> [--lib] [--target native|js|bvm]   create a project, like github.com/you/app")
    print("  ash install                     install everything in burn.toml")
    print("  ash install <name>[@version]    add a package (git repos with a burn.toml)")
    print("  ash remove <name>               remove a package")
    print("  ash update [name]               update to the newest allowed versions")
    print("  ash sync                        refresh the package index, then install everything in burn.toml")
    print("  ash list                        show the installed packages")
    print("  -p <member>                     in a workspace, work on one member (install, build, test, ...)")
    print("")
    print(bold("Running"))
    print("  ash run <script> [args]         run a script from burn.toml; `ash <script>` works too")
    print("  ash build | start | test        build, run or test the project (or its script of that name)")
    print("  ash check | fmt                 type-check or format the project")
    print("")
    print(bold("Commands"))
    print("  ash install -g <name|path>      install an app as a command in ~/.burn/bin")
    print("  ash remove -g <name>            uninstall a command")
    print("  ash list -g                     show installed commands")
    print("")
    print(bold("Sharing"))
    print("  ash search [words]              find packages in the ash index")
    print("  ash info <name>                 show a package's versions")
    print("  ash publish [--tag]             check that others can install this project")
    print("")
    print(bold("Versions") + " in burn.toml: \"^1.2\" (default, compatible updates), \"~1.2\", \"=1.2.3\", \">=1.2\", \"*\",")
    print("a branch like \"main\", or \"#<commit>\". Lock files pin exact commits in burn.lock.")
}

priv fun takeFlags(args: [string], flags: [string]): [string] {
    var rest: [string] = []
    for (a in args) {
        if (!contains(flags, a)) {
            rest.push(a)
        }
    }
    return rest
}

priv fun option(args: [string], name: string): string {
    for i, a in args {
        if (a == name && i + 1 < len(args)) {
            return args[i + 1]
        }
        if (startsWith(a, name + "=")) {
            return substring(a, len(name) + 1)
        }
    }
    return ""
}

priv fun positional(args: [string], valued: [string]): [string] {
    var out: [string] = []
    var skip = false
    for (a in args) {
        if (skip) {
            skip = false
            continue
        }
        if (contains(valued, a)) {
            skip = true
            continue
        }
        if (startsWith(a, "-")) {
            continue
        }
        out.push(a)
    }
    return out
}

priv fun requireGit() {
    if (!hasGit()) {
        die("git is not installed", "ash downloads packages with git; install it and try again")
    }
}

priv fun cmdInstall(args: [string]) {
    var global = contains(args, "-g") || contains(args, "--global")
    var git = option(args, "--git")
    var names = positional(args, ["--git"])
    if (global) {
        if (len(names) == 0) {
            die("which app should be installed?", "for example `ash install -g github.com/you/tool`, or `ash install -g .` for this project")
        }
        for (n in names) {
            var r = parseRequest(n, git)
            if (r.path == "") {
                requireGit()
            }
            installTool(r)
        }
        return
    }
    if (len(names) == 0) {
        requireGit()
        installAll()
        return
    }
    if (git != "" && len(names) > 1) {
        die("--git works with one package at a time", "")
    }
    var requests: [Request] = []
    for (n in names) {
        requests.push(parseRequest(n, git))
    }
    requireGit()
    installPackages(requests)
}

priv fun cmdRemove(args: [string]) {
    var names = positional(args, [])
    if (len(names) == 0) {
        die("which package should be removed?", "see the installed ones with `ash list`")
    }
    if (contains(args, "-g") || contains(args, "--global")) {
        for (n in names) {
            removeTool(n)
        }
        return
    }
    removePackages(names)
}

priv fun scriptOr(name: string, rest: [string], fallback: [string]): int {
    var root = projectRoot()
    if (workspaceOnly(root)) {
        var args = copy(fallback)
        if (name == "test") {
            args = ["test"]
        }
        for (a in rest) {
            args.push(a)
        }
        Process.setCwd(root)
        return runBurn(args)
    }
    var m = readManifest(root)
    if (m.scripts[name] != null) {
        return runScript(m, name, rest)
    }
    if (name == "test") {
        return runTests(m, rest)
    }
    var args = copy(fallback)
    for (a in rest) {
        args.push(a)
    }
    Process.setCwd(m.root)
    return runBurn(args)
}

priv fun cmdFmt(rest: [string]) {
    var root = projectRoot()
    var files = sourceFiles(root)
    if (len(files) == 0) {
        return
    }
    var args = ["fmt"]
    if (contains(rest, "--check")) {
        args.push("--check")
    } else {
        args.push("-w")
    }
    for (f in files) {
        args.push(relPath(Process.cwd(), f))
    }
    exit(runBurn(args))
}

priv fun enterMember(argv: [string]): [string] {
    var rest: [string] = []
    var member = ""
    var skip = false
    for i, a in argv {
        if (skip) {
            skip = false
            continue
        }
        if ((a == "-p" || a == "--package") && i + 1 < len(argv)) {
            member = argv[i + 1]
            skip = true
            continue
        }
        rest.push(a)
    }
    if (member == "") {
        return argv
    }
    var root = findProjectRoot(".")
    var ws: Workspace? = null
    if (root != "") {
        ws = workspaceOf(root)
    }
    if (ws == null) {
        die("`-p ${member}` picks a member of a workspace, but there is no workspace here", "")
    }
    for i, p in ws!!.paths {
        var dir = ws!!.dirs[i]
        var name = ""
        if (Files.isFile(dir + "/burn.toml")) {
            name = readManifest(dir).name
        }
        if (p == member || baseName(dir) == member || name == member || (name != "" && baseName(name) == member)) {
            Process.setCwd(dir)
            return rest
        }
    }
    die("the workspace has no member `${member}`", "its members are " + join(ws!!.paths, ", "))
    return rest
}

fun main() {
    var argv = enterMember(args())
    if (len(argv) == 0) {
        help()
        return
    }
    var cmd = argv[0]
    var rest = slice(argv, 1)
    if (cmd == "-h" || cmd == "--help" || cmd == "help") {
        help()
    } else if (cmd == "-v" || cmd == "--version" || cmd == "version") {
        print("ash " + VERSION)
    } else if (cmd == "init" || cmd == "new") {
        var a = ["init"]
        for (x in rest) {
            a.push(x)
        }
        exit(runBurn(a))
    } else if (cmd == "install" || cmd == "i" || cmd == "add") {
        cmdInstall(rest)
    } else if (cmd == "sync" || cmd == "reload") {
        requireGit()
        if (updateIndex()) {
            step("Updated", "the package index")
        } else {
            warn("cannot fetch the package index from ${indexUrl()}")
        }
        installAll()
    } else if (cmd == "remove" || cmd == "rm" || cmd == "uninstall") {
        cmdRemove(rest)
    } else if (cmd == "update" || cmd == "up" || cmd == "upgrade") {
        requireGit()
        updatePackages(positional(rest, []))
    } else if (cmd == "list" || cmd == "ls") {
        if (contains(rest, "-g") || contains(rest, "--global")) {
            listTools()
        } else {
            listPackages()
        }
    } else if (cmd == "run") {
        var m = readManifest(projectRoot())
        if (len(rest) == 0) {
            listScripts(m)
        } else if (m.scripts[rest[0]] == null && (rest[0] == "build" || rest[0] == "start" || rest[0] == "test")) {
            exit(scriptOr(rest[0], slice(rest, 1), ["run"]))
        } else {
            exit(runScript(m, rest[0], slice(rest, 1)))
        }
    } else if (cmd == "build") {
        exit(scriptOr("build", rest, ["build"]))
    } else if (cmd == "start" || cmd == "dev") {
        exit(scriptOr(cmd, rest, ["run", "--"]))
    } else if (cmd == "test") {
        exit(scriptOr("test", rest, []))
    } else if (cmd == "check") {
        exit(scriptOr("check", rest, ["check"]))
    } else if (cmd == "fmt") {
        cmdFmt(rest)
    } else if (cmd == "search" || cmd == "find") {
        requireGit()
        search(rest)
    } else if (cmd == "info" || cmd == "show") {
        if (len(rest) == 0) {
            die("which package?", "for example `ash info github.com/burnlang/ash`")
        }
        requireGit()
        info(rest[0])
    } else if (cmd == "publish") {
        publish(projectRoot(), contains(rest, "--tag"))
    } else if (cmd == "cache") {
        if (len(rest) > 0 && rest[0] == "clean") {
            Files.remove(burnHome() + "/packages")
            step("Removed", "the download cache in ${burnHome()}/packages")
        } else {
            print(burnHome() + "/packages")
        }
    } else {
        var root = findProjectRoot(".")
        if (root != "") {
            var m = readManifest(root)
            if (m.scripts[cmd] != null) {
                exit(runScript(m, cmd, rest))
            }
        }
        var help = "see `ash help`"
        if (root != "") {
            var m = readManifest(root)
            if (len(m.scriptNames) > 0) {
                help = "the scripts in burn.toml are " + join(m.scriptNames, ", ") + "; see `ash help` for commands"
            }
        }
        die("`${cmd}` is not an ash command or a script in burn.toml", help)
    }
}
