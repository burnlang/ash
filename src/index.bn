import "fs"
import "process"
import "strings"
import "git.bn"
import "manifest.bn"
import "paths.bn"
import "semver.bn"
import "toml.bn"
import "ui.bn"
import "project.bn"
import "std/time"
import "std/math"

pub def type IndexEntry {
    string name
    string description
    string kind
    [string] keywords
}

pub fun indexUrl(): string {
    var u = env("ASH_INDEX")
    if (u != "") {
        return u
    }
    return "https://github.com/burnlang/ash-index"
}

priv fun indexDir(): string {
    return burnHome() + "/index"
}

priv fun refreshIndex(force: bool): bool {
    var dir = indexDir()
    var stamp = burnHome() + "/index.fetched"
    if (Files.isDir(dir + "/.git")) {
        var last = 0
        if (Files.isFile(stamp)) {
            var t = trim(readFile(stamp))
            if (isInt(t)) {
                last = toInt(t)
            }
        }
        if (!force && nowMs() - last < 3600000) {
            return true
        }
        var pull = Process.output("git", ["-C", dir, "pull", "-q", "--ff-only"])
        if (pull.code == 0) {
            writeFile(stamp, toString(nowMs()))
        }
        return true
    }
    Files.makeDir(burnHome())
    step("Fetching", "the package index")
    var c = Process.output("env", ["GIT_TERMINAL_PROMPT=0", "git", "clone", "-q", "--depth", "1", indexUrl(), dir])
    if (c.code != 0) {
        Files.remove(dir)
        return false
    }
    writeFile(stamp, toString(nowMs()))
    return true
}

priv fun walk(dir: string, out: [IndexEntry]) {
    for (n in Files.list(dir)) {
        var p = dir + "/" + n
        if (Files.isDir(p)) {
            walk(p, out)
        } else if (endsWith(n, ".toml")) {
            var doc = tomlParse(readFile(p))
            if (doc.error != "") {
                continue
            }
            var t = tomlTable(doc, "")
            var entry = IndexEntry {
                name: tomlText(t, "name", ""),
                description: tomlText(t, "description", ""),
                kind: tomlText(t, "kind", "lib"),
                keywords: tomlGet(t, "keywords")?.items ?? []
            }
            out.push(entry)
        }
    }
}

pub fun updateIndex(): bool {
    return refreshIndex(true)
}

pub fun loadIndex(force: bool): [IndexEntry] {
    var out: [IndexEntry] = []
    if (!refreshIndex(force)) {
        warn("cannot fetch the package index from ${indexUrl()}")
        return out
    }
    walk(indexDir() + "/packages", out)
    return out
}

priv fun score(e: IndexEntry, words: [string]): int {
    var total = 0
    for (w in words) {
        var q = lower(w)
        var s = 0
        if (contains(lower(baseName(e.name)), q)) {
            s = 3
        } else if (contains(lower(e.name), q)) {
            s = 2
        } else if (contains(lower(e.description), q)) {
            s = 1
        }
        for (k in e.keywords) {
            if (lower(k) == q && s < 2) {
                s = 2
            }
        }
        if (s == 0) {
            return 0
        }
        total += s
    }
    return total
}

pub fun search(words: [string]) {
    var entries = loadIndex(false)
    var hits: [string] = []
    var width = 0
    for (e in entries) {
        if (len(words) == 0 || score(e, words) > 0) {
            hits.push(e.name)
            width = max(width, len(e.name))
        }
    }
    if (len(hits) == 0) {
        print(dim("nothing found; any git repository with a burn.toml can still be installed by its name"))
        return
    }
    sort(hits)
    for (h in hits) {
        for (e in entries) {
            if (e.name == h) {
                var tag = ""
                if (e.kind == "app") {
                    tag = yellow(" [app]")
                }
                print(green(padRight(e.name, width, " ")) + "  " + e.description + tag)
            }
        }
    }
}

pub fun info(name: string) {
    if (!validName(name)) {
        die("`${name}` is not a package name", nameHelp())
    }
    var url = "https://" + name
    var r = lsRemote(url)
    if (r.error != "") {
        die("cannot reach ${name}: ${r.error}", "")
    }
    print(bold(name))
    for (e in loadIndex(false)) {
        if (e.name == name) {
            if (e.description != "") {
                print(e.description)
            }
            if (e.kind == "app") {
                print(dim("an app: install it with `ash install -g ${name}`"))
            }
        }
    }
    var versions: [string] = []
    for tag, sha in r.tags {
        if (parseVersion(tag).ok) {
            versions.push(tag)
        }
    }
    var n = len(versions)
    var i = 0
    while (i < n) {
        var j = i + 1
        while (j < n) {
            if (compareVersions(parseVersion(versions[j]), parseVersion(versions[i])) > 0) {
                var tmp = versions[i]
                versions[i] = versions[j]
                versions[j] = tmp
            }
            j += 1
        }
        i += 1
    }
    if (len(versions) == 0) {
        print("versions: " + dim("none tagged yet; installs use the newest commit on " + r.headBranch))
    } else {
        print("versions: " + cyan(join(slice(versions, 0, min(len(versions), 12)), ", ")))
    }
    print("install:  ash install " + name)
}

priv fun normalizeRemote(url: string): string {
    var u = trim(url)
    if (startsWith(u, "git@")) {
        u = replace(substring(u, 4), ":", "/")
    }
    for (p in ["https://", "http://", "ssh://git@", "ssh://", "git://"]) {
        if (startsWith(u, p)) {
            u = substring(u, len(p))
        }
    }
    if (endsWith(u, ".git")) {
        u = substring(u, 0, len(u) - 4)
    }
    return lower(u)
}

pub fun publish(root: string, tagIt: bool) {
    var m = readManifest(root)
    Process.setCwd(root)
    var problems = 0
    step("Checking", "${m.name} ${m.version}")
    var check = runBurn(["check"])
    if (check != 0) {
        die("${m.name} has errors", "fix them before publishing")
    }
    var origin = Process.output("git", ["remote", "get-url", "origin"])
    if (origin.code != 0) {
        warn("this project has no git remote called origin")
        problems += 1
    } else if (normalizeRemote(origin.out) != lower(repoOf(m.name))) {
        warn("origin is ${trim(origin.out)}, but the package is named ${m.name}; people install it from https://${repoOf(m.name)}")
        problems += 1
    }
    var dirty = Process.output("git", ["status", "--porcelain"])
    if (trim(dirty.out) != "") {
        warn("there are uncommitted changes")
        problems += 1
    }
    var tag = "v" + m.version
    var local = Process.output("git", ["tag", "-l", tag])
    if (trim(local.out) == "") {
        if (tagIt) {
            if (Process.run("git", ["tag", tag]) != 0) {
                die("cannot create the tag ${tag}", "")
            }
            step("Tagged", tag)
        } else {
            warn("the version is not tagged yet: run `ash publish --tag`, or `git tag ${tag}`")
            problems += 1
        }
    }
    if (tagIt && origin.code == 0) {
        if (Process.run("git", ["push", "-q", "origin", tag]) != 0) {
            die("cannot push ${tag} to origin", "")
        }
        step("Pushed", tag)
    } else if (origin.code == 0) {
        var remote = lsRemote(trim(origin.out))
        if (remote.error == "" && remote.tags[tag] == null) {
            warn("${tag} is not pushed yet: `git push origin ${tag}`")
            problems += 1
        }
    }
    if (problems > 0) {
        print("")
        print("fix the warnings above, then run `ash publish` again")
        exit(1)
    }
    print("")
    step("Ready", "anyone can now run `ash install ${m.name}`")
    print("")
    print("To list it in `ash search`, open an issue with its git URL, https://${m.name}, at")
    print(cyan(indexUrl() + "/issues/new?template=add-package.yml"))
    print(dim("The index checks the repository and adds it automatically."))
    if (m.description == "") {
        print("")
        warn("burn.toml has no description; add one to [package], or write it in the issue")
    }
}
